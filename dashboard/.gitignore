node_modules/
.next/
next-env.d.ts
*.tsbuildinfo

# Deny-by-default: anything generated from real transactions (same sensitivity
# as the clean/ CSVs) stays out of the repo even if it is added later.
# Regenerate the real file with:
#   ../.venv/bin/python ../export_dashboard_data.py
# The synthetic sample is the one exception — it is what the deploy serves,
# and it is regenerated by ../build_sample.py.
data/*
!data/sample.metrics.json
